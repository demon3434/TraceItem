# ==========================================
# 图觅 (TraceItem) 环境变量配置示例
# 使用方法：cp .env.example .env 后按实际环境修改
# ==========================================

# 对外暴露的 Web 与 API 服务端口
HOST_PORT=8085

# 局域网 mDNS 自动发现广播地址（多网卡宿主机建议填写实际局域网 IP，留空则自动探测）
SERVICE_ADVERTISE_HOST=
SERVICE_ADVERTISE_PORT=8085

# 首次启动自动初始化的管理员账号密码（建议首次登录后在网页端修改密码）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# JWT 签名密钥（生产环境请务必替换为随机长字符串）
SECRET_KEY=traceitem-secure-secret-key-change-in-production-2026

# 是否允许新用户公开注册（true 允许 / false 仅管理员可创建账号）
ALLOW_PUBLIC_REGISTRATION=true

# 历史 TAR 备份最大保留份数
BACKUP_MAX_RETENTION_COUNT=3

